{
    "name": "smart-dato/correos-shipping-sdk",
    "description": "Laravel package for integrating Correos shipping, labels, customs documents, and tracking via Saloon.",
    "keywords": [
        "SmartDato",
        "laravel",
        "correos-shipping-sdk"
    ],
    "homepage": "https://github.com/smart-dato/correos-shipping-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "SmartDato",
            "email": "info@smart-dato.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "composer-runtime-api": "^2.2",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "saloonphp/saloon": "^4.0",
        "spatie/laravel-data": "^4.19",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.1.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-rector": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.6",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "SmartDato\\CorreosShipping\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmartDato\\CorreosShipping\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "rector": "vendor/bin/rector process",
        "rector-dry": "vendor/bin/rector process --dry-run"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SmartDato\\CorreosShipping\\CorreosShippingServiceProvider"
            ],
            "aliases": {
                "CorreosShipping": "SmartDato\\CorreosShipping\\Facades\\CorreosShipping"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
